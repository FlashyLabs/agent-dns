{
  "contract": "agent-dns/1",
  "description": "x- keys are private extensions and pass; one trailing \";\" is allowed; the domain is case-insensitive.",
  "domain": "Example.COM.",
  "records": [
    "v=agent1;url=https://example.com/.well-known/agent;x-note=hello;"
  ],
  "expect": {
    "state": "ok",
    "url": "https://example.com/.well-known/agent",
    "record": {
      "v": "agent1",
      "url": "https://example.com/.well-known/agent",
      "x-note": "hello"
    }
  }
}
